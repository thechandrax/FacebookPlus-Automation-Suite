# Server Config
PORT=3000
# Optional but strongly recommended once this is reachable beyond localhost:
# set this to a long random string, then send it as an "x-api-key" header
# (or ?apiKey= query param) on every /api request. Leave blank to disable auth.
DASHBOARD_API_KEY=

# Facebook Graph API Config
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v19.0

# AI Text Providers (Gemini & Groq)
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: Add extra Groq keys for high-availability key rotation pool
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
DEFAULT_AI_PROVIDER=groq

# AI Image Provider (Hugging Face Free Token - No Credit Card Needed)
# Get Free Token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
IMAGE_GENERATOR_TYPE=canvas_banner

# Automation & Post Settings
AUTO_POST_ENABLED=false
POST_LANGUAGE=bengali_english_mixed
CRON_SCHEDULE_TIMES=0 8 * * *,0 13 * * *,0 19 * * *
